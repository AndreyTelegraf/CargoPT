BOT_TOKEN=
DATABASE_URL=postgresql+asyncpg://cargopt:cargopt@localhost:5432/cargopt
ENVIRONMENT=local
LOG_LEVEL=INFO

EMAIL_ENABLED=false
EMAIL_TRANSPORT=smtp
EMAIL_PUBLIC_BASE_URL=https://cargopt.pt
EMAIL_FROM_NAME=CargoPT
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_USE_TLS=false
EMAIL_TIMEOUT_SECONDS=15
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_SECONDS=60

# Meta Operations Console is dormant until explicitly enabled.
META_OPERATIONS_ENABLED=false
META_OPERATIONS_INBOUND_TOKEN=
META_OPERATIONS_ADMIN_USERNAME=
META_OPERATIONS_ADMIN_PASSWORD=
META_OPERATIONS_TELEGRAM_CHAT_IDS=
META_OPERATIONS_ALERT_THRESHOLD=0.6
